# Whitehouse Expense Management - Environment Configuration
# Copy this file to .env and adjust values for your environment (Local / Amazon RDS / AWS)

# Security
SECRET_KEY=django-insecure-your-secret-key-here-for-production-use-2026
DEBUG=True
ALLOWED_HOSTS=*

# Amazon RDS PostgreSQL Configuration
# Format: postgres://<DB_USER>:<DB_PASSWORD>@<RDS_ENDPOINT>:5432/<DB_NAME>
# Example: postgres://postgres:MySecurePass123@whitehouse-rds.c7xxxxxx.ap-south-1.rds.amazonaws.com:5432/whitehouse_db
DATABASE_URL=postgres://postgres:postgres_secure_password_2026@localhost:5432/whitehouse_db

# CORS Allowed Origins (Frontend React Application)
# CORS_ALLOWED_ORIGINS=https://pawanpawar03.github.io,http://localhost:5173

# Optional: Amazon S3 Media Storage
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_STORAGE_BUCKET_NAME=whitehouse-expenses-media
# AWS_S3_REGION_NAME=ap-south-1
